generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("partner") // admin or partner
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  partner   Partner?
}

model Partner {
  id              String         @id @default(cuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName     String
  contactPerson   String
  email           String
  phone           String
  address         String
  taxId           String

  // Tier System
  currentTier     TierLevel      @default(BRONZE)
  annualRevenue   Float          @default(0)
  fiscalYearStart DateTime       @default(now())
  lastTierUpdate  DateTime       @updatedAt

  // Legacy field - kept for backward compatibility during migration
  markup          Float?         @default(20)

  status          String         @default("pending") // pending, approved, rejected, suspended
  notes           String         @default("")
  approvedAt      DateTime?
  approvedBy      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  bonusServices   BonusService[]
  orders          Order[]
  contracts       Contract[]
}

model PartnerApplication {
  id            String   @id @default(cuid())
  companyName   String
  contactPerson String
  email         String
  phone         String
  address       String
  taxId         String
  message       String
  status        String   @default("pending") // pending, approved, rejected
  reviewedAt    DateTime?
  reviewedBy    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique // Legacy - kept for backwards compatibility
  slugRo      String   @unique
  slugEn      String   @unique
  slugIt      String   @unique
  titleRo     String
  titleEn     String
  titleIt     String
  contentRo   String
  contentEn   String
  contentIt   String
  excerptRo   String
  excerptEn   String
  excerptIt   String
  author      String
  tags        String   @default("[]") // JSON string array
  status      String   @default("draft") // draft or published
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  name        String
  basePrice   Float
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSettings {
  id            String   @id @default("main")
  analyticsCode String   @default("")
  chatbotCode   String   @default("")
  updatedAt     DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  status    String   @default("active") // active or unsubscribed
  source    String   @default("website") // website, partner, etc
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tier System Models

model BonusService {
  id          String      @id @default(cuid())
  partnerId   String
  partner     Partner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  serviceName String
  serviceType String      // "logo", "seo-audit", "landing-page", etc
  value       Float       // Valore del servizio in euro
  locale      String      @default("ro") // ro, it, en - determina il prezzo
  status      BonusStatus @default(AVAILABLE)
  assignedAt  DateTime    @default(now())
  usedAt      DateTime?
  expiresAt   DateTime    // Fine anno fiscale
  notes       String      @default("")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([partnerId])
  @@index([status])
}

model ServicePricing {
  id            String   @id @default(cuid())
  serviceType   String   @unique // "web-design-basic", "web-design-premium", etc
  serviceName   String   // Nome visualizzato
  category      String   // "web-design", "seo", "social-media", etc
  priceRo       Float    // Prezzo in Romania
  priceIt       Float    // Prezzo in Italia
  priceEn       Float    // Prezzo altri paesi (English)
  description   String   @default("")
  isActive      Boolean  @default(true)
  isRecurring   Boolean  @default(false) // true per servizi mensili
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

model Order {
  id            String      @id @default(cuid())
  partnerId     String
  partner       Partner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  serviceType   String      // Riferimento a ServicePricing.serviceType
  serviceName   String
  clientName    String
  clientEmail   String
  amount        Float       // Prezzo pieno al cliente
  partnerCost   Float       // Costo per il partner (dopo sconto tier)
  discount      Float       // Percentuale sconto applicata
  locale        String      @default("ro") // ro, it, en
  status        OrderStatus @default(PENDING)
  orderDate     DateTime    @default(now())
  completedAt   DateTime?
  cancelledAt   DateTime?
  notes         String      @default("")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([partnerId])
  @@index([status])
  @@index([orderDate])
}

model Contract {
  id              String         @id @default(cuid())
  partnerId       String
  partner         Partner        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  orderId         String?        // Optional reference to an order
  contractNumber  String         @unique // e.g., "CONTR-2024-001"
  contractType    String         // "partnership", "service", "nda", etc.
  fileName        String
  fileUrl         String         // URL del file nel cloud storage
  fileSize        Int            // Dimensione file in bytes
  mimeType        String         // "application/pdf", ecc.
  status          ContractStatus @default(PENDING)
  signedAt        DateTime?
  expiresAt       DateTime?
  notes           String         @default("")
  uploadedAt      DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([partnerId])
  @@index([status])
  @@index([contractNumber])
}

// Enums

enum TierLevel {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum BonusStatus {
  AVAILABLE // Disponibile da usare
  USED      // Già utilizzato
  EXPIRED   // Scaduto (fine anno)
}

enum OrderStatus {
  PENDING      // In attesa
  IN_PROGRESS  // In lavorazione
  COMPLETED    // Completato
  CANCELLED    // Annullato
}

enum ContractStatus {
  PENDING      // In attesa di firma
  SIGNED       // Firmato
  EXPIRED      // Scaduto
  REJECTED     // Rifiutato
  ARCHIVED     // Archiviato
}
