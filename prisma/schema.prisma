generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("partner") // admin or partner
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  partner   Partner?
}

model Partner {
  id              String         @id @default(cuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName     String
  contactPerson   String
  email           String
  phone           String
  address         String
  taxId           String

  // Tier System
  currentTier     TierLevel      @default(BRONZE)
  annualRevenue   Float          @default(0)
  fiscalYearStart DateTime       @default(now())
  lastTierUpdate  DateTime       @updatedAt

  // Legacy field - kept for backward compatibility during migration
  markup          Float?         @default(20)

  status          String         @default("pending") // pending, approved, rejected, suspended
  notes           String         @default("")
  approvedAt      DateTime?
  approvedBy      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  bonusServices   BonusService[]
  orders          Order[]
  contracts       Contract[]
}

model PartnerApplication {
  id            String   @id @default(cuid())
  companyName   String
  contactPerson String
  email         String
  phone         String
  address       String
  taxId         String
  message       String
  status        String   @default("pending") // pending, approved, rejected
  reviewedAt    DateTime?
  reviewedBy    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique // Legacy - kept for backwards compatibility
  slugRo      String   @unique
  slugEn      String   @unique
  slugIt      String   @unique
  titleRo     String
  titleEn     String
  titleIt     String
  contentRo   String
  contentEn   String
  contentIt   String
  excerptRo   String
  excerptEn   String
  excerptIt   String
  author      String
  imageUrl    String?
  tags        String   @default("[]") // JSON string array
  status      String   @default("draft") // draft or published
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  name        String
  basePrice   Float
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSettings {
  id            String   @id @default("main")
  analyticsCode String   @default("")
  chatbotCode   String   @default("")
  
  // SMTP Settings
  smtpHost      String   @default("")
  smtpPort      String   @default("465")
  smtpUser      String   @default("")
  smtpPassword  String   @default("")
  
  updatedAt     DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  status    String   @default("active") // active or unsubscribed
  source    String   @default("website") // website, partner, etc
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tier System Models

model BonusService {
  id          String      @id @default(cuid())
  partnerId   String
  partner     Partner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  serviceName String
  serviceType String      // "logo", "seo-audit", "landing-page", etc
  value       Float       // Valore del servizio in euro
  locale      String      @default("ro") // ro, it, en - determina il prezzo
  status      BonusStatus @default(AVAILABLE)
  assignedAt  DateTime    @default(now())
  usedAt      DateTime?
  expiresAt   DateTime    // Fine anno fiscale
  notes       String      @default("")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([partnerId])
  @@index([status])
}

model ServicePricing {
  id            String   @id @default(cuid())
  serviceType   String   @unique // "web-design-basic", "web-design-premium", etc
  serviceName   String   // Nome visualizzato
  category      String   // "web-design", "seo", "social-media", etc
  priceRo       Float    // Prezzo in Romania
  priceIt       Float    // Prezzo in Italia
  priceEn       Float    // Prezzo altri paesi (English)
  description   String   @default("")
  isActive      Boolean  @default(true)
  isRecurring   Boolean  @default(false) // true per servizi mensili
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

model Order {
  id            String      @id @default(cuid())
  partnerId     String
  partner       Partner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  serviceType   String      // Riferimento a ServicePricing.serviceType
  serviceName   String
  clientName    String
  clientEmail   String
  amount        Float       // Prezzo pieno al cliente
  partnerCost   Float       // Costo per il partner (dopo sconto tier)
  discount      Float       // Percentuale sconto applicata
  locale        String      @default("ro") // ro, it, en
  status        OrderStatus @default(PENDING)
  orderDate     DateTime    @default(now())
  completedAt   DateTime?
  cancelledAt   DateTime?
  notes         String      @default("")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([partnerId])
  @@index([status])
  @@index([orderDate])
}

model Contract {
  id              String         @id @default(cuid())
  partnerId       String
  partner         Partner        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  orderId         String?        // Optional reference to an order
  contractNumber  String         @unique // e.g., "CONTR-2024-001"
  contractType    String         // "partnership", "service", "nda", etc.
  fileName        String
  fileUrl         String         // URL del file nel cloud storage
  fileSize        Int            // Dimensione file in bytes
  mimeType        String         // "application/pdf", ecc.
  status          ContractStatus @default(PENDING)
  signedAt        DateTime?
  expiresAt       DateTime?
  notes           String         @default("")
  uploadedAt      DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([partnerId])
  @@index([status])
  @@index([contractNumber])
}

// Enums

enum TierLevel {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum BonusStatus {
  AVAILABLE // Disponibile da usare
  USED      // Già utilizzato
  EXPIRED   // Scaduto (fine anno)
}

enum OrderStatus {
  PENDING      // In attesa
  IN_PROGRESS  // In lavorazione
  COMPLETED    // Completato
  CANCELLED    // Annullato
}

enum ContractStatus {
  PENDING      // In attesa di firma
  SIGNED       // Firmato
  EXPIRED      // Scaduto
  REJECTED     // Rifiutato
  ARCHIVED     // Archiviato
}

model CookieConsent {
  id                String   @id @default(cuid())
  userId            String?  // Optional - for logged in users
  sessionId         String   // Cookie/session identifier for anonymous users
  ipAddress         String?
  userAgent         String?

  // Consent preferences
  necessary         Boolean  @default(true)  // Always true
  analytics         Boolean  @default(false)
  marketing         Boolean  @default(false)
  preferences       Boolean  @default(false)

  // Metadata
  consentVersion    String   @default("1.0") // Track policy version
  locale            String   @default("en")
  consentDate       DateTime @default(now())
  lastUpdated       DateTime @updatedAt
  expiresAt         DateTime // When consent expires (usually 1 year)

  @@index([sessionId])
  @@index([userId])
  @@index([consentDate])
}

model TeamMember {
  id          String   @id @default(cuid())
  name        String
  roleRo      String
  roleEn      String
  roleIt      String
  bioRo       String?
  bioEn       String?
  bioIt       String?
  imageUrl    String?
  socialLinks String?  @default("{}") // JSON string
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id              String   @id @default(cuid())
  slug            String   @unique

  // Product info
  name            String
  taglineRo       String
  taglineEn       String
  taglineIt       String

  // Problem & solution
  problemRo       String   // What problem does it solve
  problemEn       String
  problemIt       String

  // Descriptions
  descriptionRo   String
  descriptionEn   String
  descriptionIt   String

  // Features (JSON array of strings)
  featuresRo      String   @default("[]")
  featuresEn      String   @default("[]")
  featuresIt      String   @default("[]")

  // Tech details
  techStack       String   @default("[]") // JSON array: ["Next.js", "PostgreSQL", "AI"]

  // Media
  imageUrl        String?
  logoUrl         String?
  demoUrl         String?  // Link to live product
  caseStudyUrl    String?  // Link to detailed case study

  // Metrics
  usersCount      String?  // "1000+", "500+ businesses"
  automationSaved String?  // "80% time saved", "10 hours/week"

  // Status & category
  status          ProductStatus @default(LIVE)
  category        String        // "AI Automation", "E-commerce", "SaaS"

  // SEO
  metaTitleRo     String?
  metaTitleEn     String?
  metaTitleIt     String?
  metaDescRo      String?
  metaDescEn      String?
  metaDescIt      String?

  // Display
  featured        Boolean  @default(false)
  order           Int      @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([featured])
  @@index([category])
}

enum ProductStatus {
  LIVE         // Produs live și funcțional
  BETA         // În testare
  DEVELOPMENT  // În dezvoltare
  ARCHIVED     // Arhivat/întreținut
}
